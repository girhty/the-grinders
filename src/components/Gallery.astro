---
<section id="gallery" class="relative py-24 px-5 sm:px-8 max-w-7xl mx-auto">
  <div class="reveal text-center mb-14 max-w-2xl mx-auto">
    <span class="text-amber-300 text-xs uppercase tracking-[0.3em]">@grinders.iq</span>
    <h2 class="font-display text-4xl sm:text-5xl text-cream-50 mt-3 mb-4">From Our Feed</h2>
    <p class="text-cream-200/70">A glimpse into every cup, every branch, every moment worth grinding for.</p>
  </div>

  {posts.length > 0 ? (
    <div class="grid grid-cols-2 sm:grid-cols-4 auto-rows-[190px] gap-4 reveal-stagger">
      {posts.map((post, i) => (
        <div class={`group relative rounded-2xl overflow-hidden border border-white/10 shadow-lg ${spanClasses[i % spanClasses.length]}`}>
          <img
            src={post.image_url}
            alt={post.caption ? post.caption.slice(0, 60) : "Instagram post from The Grinders"}
            loading="lazy"
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
            onerror="this.src='https://placehold.co/600x600/2b1b12/d4a574?text=The+Grinders'"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-espresso-950/95 via-espresso-950/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-400 flex flex-col justify-end p-4">
            <p class="text-cream-50 text-xs sm:text-sm leading-snug line-clamp-4">{post.caption || "The Grinders — Grind & unwind."}</p>
            <div class="flex items-center gap-4 mt-3 text-cream-200/80 text-xs">
              <span class="flex items-center gap-1">
                <svg class="w-3.5 h-3.5 fill-amber-300" viewBox="0 0 24 24"><path d="M12 21s-6.7-4.35-9.33-8.14C.86 10.54 1.4 7.1 4.1 5.6 6.2 4.4 8.7 5 10 6.9c1.3-1.9 3.8-2.5 5.9-1.3 2.7 1.5 3.24 4.94 1.43 7.26C18.7 16.65 12 21 12 21z" /></svg>
                {post.likes}
              </span>
              <span class="flex items-center gap-1">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z" /></svg>
                View
              </span>
            </div>
          </div>
          <div class="absolute top-3 right-3 opacity-0 group-hover:opacity-100 transition-opacity">
            <svg class="w-5 h-5 text-cream-50 drop-shadow" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10 10-4.5 10-10S17.5 2 12 2zm3.9 8.6l-5.3 5.3c-.2.2-.5.2-.7 0l-2.8-2.8c-.2-.2-.2-.5 0-.7l.7-.7c.2-.2.5-.2.7 0l1.7 1.7 4.3-4.3c.2-.2.5-.2.7 0l.7.7c.2.2.2.5 0 .8z"/></svg>
          </div>
        </div>
      ))}
    </div>
  ) : (
    <div class="text-center py-20 border border-dashed border-white/15 rounded-2xl text-cream-200/60">
      No posts available right now — check back soon or visit @grinders.iq on Instagram.
    </div>
  )}

  <div class="text-center mt-12 reveal">
    <a href="https://instagram.com/grinders.iq" target="_blank" rel="noopener"
      class="magnetic inline-flex items-center gap-2 px-7 py-3.5 rounded-full border border-amber-400/40 text-amber-300 font-semibold hover:bg-amber-400/10 transition-all">
      See More on Instagram
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
    </a>
  </div>
</section>