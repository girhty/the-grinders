---
const address = "GR98+466, Basrah, Basra Governorate";
const branches = [
  { name: "Basra — Main Branch", hours: "Daily · Hours vary", tag: "HQ" },
  { name: "Baghdad Mall — Al-Harithiya", hours: "Daily · Check Instagram", tag: "New" },
  { name: "Wazireya — Drive-Thru", hours: "Open 24/7", tag: "24/7" },
  { name: "Erbil — Empire Square", hours: "Coming Soon", tag: "Soon" },
];
const mapQuery = encodeURIComponent(address);
---
<section id="location" class="relative py-24 px-5 sm:px-8 max-w-7xl mx-auto">
  <div class="reveal text-center mb-14 max-w-2xl mx-auto">
    <span class="text-amber-300 text-xs uppercase tracking-[0.3em]">Visit Us</span>
    <h2 class="font-display text-4xl sm:text-5xl text-cream-50 mt-3 mb-4">Find Your Nearest Grind</h2>
    <p class="text-cream-200/70">Multiple branches across Iraq, each brewed with the same warmth and care.</p>
  </div>

  <div class="grid lg:grid-cols-2 gap-8">
    <!-- Map + address card -->
    <div class="reveal rounded-3xl overflow-hidden border border-white/10 shadow-2xl">
      <iframe
        title="The Grinders location map"
        class="w-full h-72 sm:h-96 border-0"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        src={`https://maps.google.com/maps?q=${mapQuery}&z=14&output=embed`}>
      </iframe>
      <div class="bg-espresso-800/80 backdrop-blur-xl border-t border-white/10 p-6">
        <div class="flex items-start justify-between gap-4 flex-wrap">
          <div class="flex items-start gap-3">
            <svg class="w-5 h-5 text-amber-300 mt-1 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a2 2 0 01-2.828 0l-4.243-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
            <div>
              <p class="text-cream-50 font-semibold text-sm">{address}</p>
              <p class="text-cream-200/60 text-xs mt-1">Primary listed location</p>
            </div>
          </div>
          <span class="inline-flex items-center gap-1.5 text-xs bg-emerald-400/10 text-emerald-300 px-3 py-1.5 rounded-full border border-emerald-400/30 whitespace-nowrap">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulseGlow"></span>
            Open Now
          </span>
        </div>
        <div class="mt-5 flex items-center gap-3 text-sm text-cream-200/70">
          <svg class="w-4 h-4 text-amber-300" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
          Phone not listed — reach us via Instagram DM
        </div>
      </div>
    </div>

    <!-- Branches list -->
    <div class="reveal-stagger grid sm:grid-cols-2 gap-4">
      {branches.map((b) => (
        <div class="group rounded-2xl p-5 bg-white/5 border border-white/10 backdrop-blur-xl hover:border-amber-400/30 hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-bold uppercase tracking-wide px-2.5 py-1 rounded-full bg-amber-400/15 text-amber-300 border border-amber-400/20">{b.tag}</span>
              <svg class="w-4 h-4 text-cream-200/40 group-hover:text-amber-300 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a2 2 0 01-2.828 0l-4.243-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
            </div>
            <p class="text-cream-50 font-display text-lg mb-1">{b.name}</p>
            <p class="text-cream-200/60 text-sm">{b.hours}</p>
          </div>
        </div>
      ))}
      <div class="sm:col-span-2 rounded-2xl p-5 bg-amber-400/10 border border-amber-400/20 text-sm text-cream-100/90 flex items-center gap-3">
        <svg class="w-5 h-5 text-amber-300 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        Exact opening hours vary by branch — follow @grinders.iq for real-time updates and announcements.
      </div>
    </div>
  </div>
</section>