---
const profilePic = "https://scontent-ams2-1.cdninstagram.com/v/t51.82787-19/656216577_18100503692477046_5261369959079597664_n.jpg?stp=dst-jpg_s150x150_tt6&_nc_cat=110&ccb=7-5&_nc_sid=f7ccc5&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLnd3dy4xMDgwLkMzIn0%3D&_nc_ohc=USdBp7sina8Q7kNvwGXfOyc&_nc_oc=Ado723nZb_3bnKJskV-WVqh0SLGwRrp4hWJWa3Hdl9rWRSMC6pfIM8qLKbUiQb5SRjA&_nc_zt=24&_nc_ht=scontent-ams2-1.cdninstagram.com&_nc_gid=H4icF26rXpkF8u4oQKiM1g&_nc_ss=7ba8c&oh=00_AQJMOX83crta65WQYvTEIFviKBkGQsJi3z2s-M3i0WPMWQ&oe=6ABCCB73";
const links = [
  { href: "#gallery", label: "Gallery" },
  { href: "#menu", label: "Seasonal" },
  { href: "#reviews", label: "Community" },
  { href: "#location", label: "Visit Us" },
];
---
<header class="fixed top-0 inset-x-0 z-50 backdrop-blur-xl bg-espresso-900/70 border-b border-amber-900/30">
  <nav class="max-w-7xl mx-auto flex items-center justify-between px-5 sm:px-8 py-3">
    <a href="#" class="flex items-center gap-3 group">
      <img src={profilePic} alt="The Grinders logo" class="w-10 h-10 rounded-full object-cover ring-2 ring-amber-400/60 group-hover:ring-amber-300 transition" />
      <div class="leading-tight">
        <p class="font-display text-lg tracking-wide text-cream-50">The Grinders</p>
        <p class="text-[10px] uppercase tracking-[0.2em] text-amber-300/80">Grind &amp; Unwind</p>
      </div>
    </a>
    <div class="hidden md:flex items-center gap-8 text-sm text-cream-200/90">
      {links.map((l) => (
        <a href={l.href} class="hover:text-amber-300 transition-colors">{l.label}</a>
      ))}
    </div>
    <div class="hidden md:flex items-center gap-3">
      <a href="https://instagram.com/grinders.iq" target="_blank" rel="noopener"
        class="magnetic px-4 py-2 rounded-full bg-amber-400 text-espresso-900 font-semibold text-sm shadow-lg shadow-amber-400/20 hover:bg-amber-300 transition-all">
        Follow @grinders.iq
      </a>
    </div>
    <button id="nav-toggle" aria-label="Toggle menu" class="md:hidden text-cream-100">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </nav>
  <div id="mobile-menu" class="hidden md:hidden border-t border-amber-900/30 bg-espresso-900/95 px-5 py-4 space-y-3">
    {links.map((l) => (
      <a href={l.href} class="block text-cream-200 hover:text-amber-300 py-1">{l.label}</a>
    ))}
    <a href="https://instagram.com/grinders.iq" target="_blank" rel="noopener"
      class="block text-center px-4 py-2 rounded-full bg-amber-400 text-espresso-900 font-semibold text-sm">
      Follow @grinders.iq
    </a>
  </div>
</header>