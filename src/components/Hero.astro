---
const profilePic = "https://scontent-ams2-1.cdninstagram.com/v/t51.82787-19/656216577_18100503692477046_5261369959079597664_n.jpg?stp=dst-jpg_s150x150_tt6&_nc_cat=110&ccb=7-5&_nc_sid=f7ccc5&efg=eyJ2ZW5jb2RlX3RhZyI6InByb2ZpbGVfcGljLnd3dy4xMDgwLkMzIn0%3D&_nc_ohc=USdBp7sina8Q7kNvwGXfOyc&_nc_oc=Ado723nZb_3bnKJskV-WVqh0SLGwRrp4hWJWa3Hdl9rWRSMC6pfIM8qLKbUiQb5SRjA&_nc_zt=24&_nc_ht=scontent-ams2-1.cdninstagram.com&_nc_gid=H4icF26rXpkF8u4oQKiM1g&_nc_ss=7ba8c&oh=00_AQJMOX83crta65WQYvTEIFviKBkGQsJi3z2s-M3i0WPMWQ&oe=6ABCCB73";
const heroPhoto = "https://lh3.googleusercontent.com/gps-cs-s/AHRPTWnyqLQFCeS0ysZmuky7lnMkIdLudjJc5NQtgbkfKRAag1Smov2FXkaRMlujz8ssXWHnNOf98mTe5V6YjZACF4ufwxbEgB7qog7eIO6mDw5GmTS8MpoD04vst_P4gwEX9s5r9Igx7ty2rtf7=w408-h725-k-no";
const rating = 4.3;
const totalRatings = 4;
const followers = 455427;
function formatFollowers(n: number) {
  if (n >= 1000000) return (n / 1000000).toFixed(1) + "M";
  if (n >= 1000) return (n / 1000).toFixed(0) + "K";
  return String(n);
}
---
<section class="relative min-h-screen flex items-center overflow-hidden pt-24 pb-16">
  <!-- Parallax blobs -->
  <div data-parallax="0.15" class="absolute -top-32 -left-32 w-96 h-96 bg-amber-500/20 rounded-full blur-3xl animate-blob"></div>
  <div data-parallax="0.25" class="absolute top-1/3 right-0 w-[28rem] h-[28rem] bg-espresso-500/30 rounded-full blur-3xl animate-blob"></div>
  <div data-parallax="0.1" class="absolute bottom-0 left-1/4 w-72 h-72 bg-amber-300/10 rounded-full blur-3xl animate-blob"></div>

  <div class="max-w-7xl w-full mx-auto px-5 sm:px-8 grid lg:grid-cols-2 gap-14 items-center relative z-10">
    <!-- Left copy -->
    <div class="reveal">
      <div class="flex items-center gap-4 mb-6">
        <img src={profilePic} alt="Grinders logo" class="w-16 h-16 rounded-full ring-4 ring-amber-400/40 object-cover shadow-xl animate-float" />
        <div>
          <p class="text-amber-300 font-semibold text-sm tracking-wide">@grinders.iq</p>
          <p class="text-cream-200/70 text-xs">{formatFollowers(followers)} followers on Instagram</p>
        </div>
      </div>

      <h1 class="font-display text-5xl sm:text-6xl lg:text-7xl leading-[1.05] text-cream-50 mb-6">
        Grind <span class="italic text-amber-300">&amp;</span><br />
        Unwind.
      </h1>
      <p class="text-lg text-cream-200/80 max-w-md mb-8 leading-relaxed">
        Specialty coffee, seasonal sips, and cozy corners — crafted for the moments that matter, from Basra to Baghdad and beyond.
      </p>

      <div class="flex flex-wrap items-center gap-4 mb-10">
        <a href="#location" class="magnetic inline-flex items-center gap-2 px-7 py-3.5 rounded-full bg-amber-400 text-espresso-900 font-semibold shadow-2xl shadow-amber-400/30 hover:bg-amber-300 transition-all">
          Find a Branch
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
        </a>
        <a href="#gallery" class="magnetic inline-flex items-center gap-2 px-7 py-3.5 rounded-full border border-cream-100/20 text-cream-100 font-semibold backdrop-blur hover:bg-cream-100/10 transition-all">
          View Gallery
        </a>
      </div>

      <!-- Social proof badge -->
      <div class="inline-flex items-center gap-4 backdrop-blur-xl bg-white/5 border border-white/10 rounded-2xl px-5 py-4">
        <div class="flex items-center gap-1 text-amber-300">
          {Array.from({ length: 5 }).map((_, i) => (
            <svg class={`w-4 h-4 ${i < Math.round(rating) ? "fill-amber-300" : "fill-cream-100/20"}`} viewBox="0 0 20 20"><path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z" /></svg>
          ))}
        </div>
        <div class="text-sm">
          <span class="font-bold text-cream-50">{rating}</span>
          <span class="text-cream-200/70"> on Google · {totalRatings} reviews</span>
        </div>
        <span class="hidden sm:inline-flex items-center gap-1.5 text-xs bg-emerald-400/10 text-emerald-300 px-2.5 py-1 rounded-full border border-emerald-400/30">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulseGlow"></span>
          Open Now
        </span>
      </div>
    </div>

    <!-- Right visual -->
    <div class="reveal relative" style="transition-delay:0.2s">
      <div class="relative rounded-[2rem] overflow-hidden shadow-2xl shadow-black/50 border border-white/10 aspect-[4/5] max-w-md mx-auto">
        <img src={heroPhoto} alt="Inside The Grinders" class="w-full h-full object-cover" loading="eager" />
        <div class="absolute inset-0 bg-gradient-to-t from-espresso-900 via-espresso-900/10 to-transparent"></div>
        <div class="absolute bottom-5 left-5 right-5 backdrop-blur-xl bg-white/10 border border-white/20 rounded-2xl px-4 py-3 flex items-center justify-between">
          <div>
            <p class="text-cream-50 font-semibold text-sm">The Grinders</p>
            <p class="text-cream-200/70 text-xs">Basra Governorate</p>
          </div>
          <span class="text-amber-300 text-xs font-bold">★ {rating}</span>
        </div>
      </div>
      <!-- floating accent card -->
      <div class="hidden sm:block absolute -bottom-8 -right-6 backdrop-blur-xl bg-espresso-800/80 border border-amber-400/30 rounded-2xl p-4 shadow-xl animate-float">
        <p class="text-xs text-amber-300 font-semibold mb-1">New Branch</p>
        <p class="text-sm text-cream-50 font-display">Erbil · Empire Square</p>
      </div>
    </div>
  </div>

  <!-- Instagram handle marquee -->
  <div class="absolute bottom-0 inset-x-0 border-t border-white/5 bg-espresso-950/60 py-3 overflow-hidden">
    <div class="flex whitespace-nowrap animate-marquee text-cream-200/40 text-sm gap-8">
      {Array.from({ length: 10 }).map(() => (
        <span class="flex items-center gap-2">✧ @grinders.iq <span class="text-amber-400/60">Grind &amp; Unwind</span></span>
      ))}
      {Array.from({ length: 10 }).map(() => (
        <span class="flex items-center gap-2">✧ @grinders.iq <span class="text-amber-400/60">Grind &amp; Unwind</span></span>
      ))}
    </div>
  </div>
</section>