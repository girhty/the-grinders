---
export interface Props {
  title: string;
  subtitle?: string;
  icon?: string;
  accent?: boolean;
}
const { title, subtitle = "", icon = "☕", accent = false } = Astro.props;
---
<div class={`reveal group relative rounded-2xl p-6 border transition-all duration-300 hover:-translate-y-2 hover:rotate-[0.3deg]
  ${accent ? "bg-amber-400/10 border-amber-400/30 hover:bg-amber-400/15" : "bg-white/5 border-white/10 hover:bg-white/10"}
  backdrop-blur-xl shadow-lg hover:shadow-2xl hover:shadow-amber-400/10`}>
  <div class="text-3xl mb-4 select-none">{icon}</div>
  <h3 class="font-display text-xl text-cream-50 mb-1">{title}</h3>
  {subtitle && <p class="text-sm text-cream-200/70 leading-relaxed"><slot>{subtitle}</slot></p>}
  {!subtitle && <div class="text-sm text-cream-200/70 leading-relaxed"><slot /></div>}
  <div class="absolute inset-0 rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none bg-gradient-to-tr from-amber-400/0 via-amber-400/5 to-transparent"></div>
</div>