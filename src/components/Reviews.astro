---
const rating = 4.3;
const totalRatings = 4;
const followers = 455427;
const buzz = [
  { quote: "24 ساعة، 7 أيام في الأسبوع — نحن هنا لخدمتك! خدمة الدرايف ثرو متواصلة على مدار الساعة.", tag: "Wazireya · Drive-Thru" },
  { quote: "كل إنجاز يبدأ بمساحة تساعدك تركز، وجلسات مريحة تخليك تكمل مهامك براحة.", tag: "Cozy Workspace Vibes" },
  { quote: "خصم 50% لمدة يومين في فرعنا الجديد داخل بغداد مول - الحارثية!", tag: "Baghdad Mall Branch" },
];
---
<section id="reviews" class="relative py-24 px-5 sm:px-8 max-w-7xl mx-auto">
  <div class="grid lg:grid-cols-5 gap-10">
    <!-- Rating summary -->
    <div class="reveal lg:col-span-2 rounded-3xl bg-gradient-to-br from-amber-400/15 to-transparent border border-amber-400/20 p-8 flex flex-col justify-between backdrop-blur-xl">
      <div>
        <span class="text-amber-300 text-xs uppercase tracking-[0.3em]">Social Proof</span>
        <h2 class="font-display text-4xl text-cream-50 mt-3 mb-6">Loved on Google &amp; Instagram</h2>
        <div class="flex items-end gap-3 mb-2">
          <p class="text-6xl font-display text-cream-50">{rating}</p>
          <div class="pb-2">
            <div class="flex gap-0.5 text-amber-300 mb-1">
              {Array.from({ length: 5 }).map((_, i) => (
                <svg class={`w-4 h-4 ${i < Math.round(rating) ? "fill-amber-300" : "fill-cream-100/20"}`} viewBox="0 0 20 20"><path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z" /></svg>
              ))}
            </div>
            <p class="text-xs text-cream-200/60">{totalRatings} Google reviews</p>
          </div>
        </div>
      </div>
      <div class="grid grid-cols-2 gap-4 mt-8">
        <div class="rounded-2xl bg-white/5 border border-white/10 p-4">
          <p class="text-2xl font-display text-amber-300">{(followers/1000).toFixed(0)}K+</p>
          <p class="text-xs text-cream-200/60 mt-1">Instagram followers</p>
        </div>
        <div class="rounded-2xl bg-white/5 border border-white/10 p-4">
          <p class="text-2xl font-display text-amber-300">4+</p>
          <p class="text-xs text-cream-200/60 mt-1">Branches across Iraq</p>
        </div>
      </div>
    </div>

    <!-- Community buzz quote cards -->
    <div class="lg:col-span-3 grid sm:grid-cols-2 gap-6 reveal-stagger">
      {buzz.map((b) => (
        <div class="group relative rounded-2xl p-6 bg-white/5 border border-white/10 backdrop-blur-xl hover:-translate-y-1.5 hover:border-amber-400/30 transition-all duration-300">
          <svg class="w-7 h-7 text-amber-400/50 mb-3" viewBox="0 0 24 24" fill="currentColor"><path d="M7.17 6C4.86 6 3 7.86 3 10.17c0 2.06 1.5 3.75 3.45 4.08-.12.7-.5 1.35-1.13 1.85-.28.22-.15.66.2.66 2.36 0 4.28-2.3 4.28-5.15V10.17C9.8 7.86 7.94 6 7.17 6zm10.66 0c-2.31 0-4.17 1.86-4.17 4.17 0 2.06 1.5 3.75 3.45 4.08-.12.7-.5 1.35-1.13 1.85-.28.22-.15.66.2.66 2.36 0 4.28-2.3 4.28-5.15V10.17C20.46 7.86 18.6 6 17.83 6z"/></svg>
          <p class="text-cream-100/90 text-sm leading-relaxed mb-4" dir="auto">{b.quote}</p>
          <p class="text-xs text-amber-300/80 font-semibold uppercase tracking-wide">{b.tag}</p>
        </div>
      ))}
      <div class="sm:col-span-2 rounded-2xl p-6 bg-amber-400/10 border border-amber-400/20 flex items-center justify-between flex-wrap gap-4">
        <p class="text-cream-100 text-sm">Been to The Grinders? Share your moment with us.</p>
        <a href="https://instagram.com/grinders.iq" target="_blank" rel="noopener" class="magnetic text-sm font-semibold text-amber-300 hover:text-amber-200 flex items-center gap-1">
          Tag @grinders.iq
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
        </a>
      </div>
    </div>
  </div>
</section>